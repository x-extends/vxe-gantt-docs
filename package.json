{
  "name": "vxe-gantt-docs",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "update": "pnpm install --no-frozen-lockfile",
    "update:v3": "cd v3 && npm run update",
    "update:v4": "cd v4 && npm run update",
    "update:all": "npm run update && concurrently --timings \"npm run update:v3\" \"npm run update:v4\"",

    "build:v3": "cd v3 && npm run pack",
    "build:v4": "cd v4 && npm run pack",
    "build:all": "concurrently --timings \"npm run build:v3\" \"npm run build:v4\"",

    "pack:v3": "npm run build:v3 && node scripts/build-pack.js v3",
    "pack:v4": "npm run build:v4 && node scripts/build-pack.js v4",
    "pack:all": "npm run build:all && node scripts/build-pack.js",

    "clean:pack": "node scripts/clean-pack.js",
    "clean:all": "node scripts/clean-all"
  },
  "devDependencies": {
    "archiver": "~8.0.0",
    "concurrently": "^10.0.6",
    "del": "~6.0.0",
    "uglify-js": "3.19.3",
    "xe-utils": "^4.2.1"
  },
  "allowScripts": {
    "es5-ext": true
  }
}
